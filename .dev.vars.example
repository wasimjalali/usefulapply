# Copy to .dev.vars and fill in locally. Names only. Never commit .dev.vars.
# OpenNext uses NEXTJS_ENV to pick which Next.js .env file to load.
NEXTJS_ENV

# Public
NEXT_PUBLIC_SITE_URL
NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_POSTHOG_KEY

# Supabase
SUPABASE_SERVICE_ROLE_KEY

# Stripe
STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_ID_PLUS
STRIPE_PRICE_ID_MAX
STRIPE_PRICE_ID_ADDON_CREDIT_PACK
STRIPE_PRICE_ID_ADDON_PACK
STRIPE_PRICE_ID_ADDON_MEDIUM
STRIPE_PRICE_ID_ADDON_LARGE

# AI
AI_PROVIDER
ANTHROPIC_API_KEY
AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN
AWS_BEARER_TOKEN_BEDROCK
AWS_BEDROCK_ENDPOINT_URL
AWS_REGION
DIGITALOCEAN_AGENT_ENDPOINT
DIGITALOCEAN_ACCESS_KEY
USE_FALLBACK_MODEL
USE_PREVIOUS_MODEL

# Job feed
SERPAPI_API_KEY
AZURE_OPENAI_ENDPOINT
AZURE_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION
AZURE_OPENAI_DEPLOYMENT

# Email: Cloudflare Email Service uses the EMAIL binding in wrangler.jsonc, no key needed.

# Cron
CRON_SECRET

# Job feed debug run. Server-only. Header: x-job-feed-debug-secret
JOB_FEED_DEBUG_SECRET

# PostHog (build-time)
POSTHOG_PERSONAL_API_KEY
POSTHOG_PROJECT_ID

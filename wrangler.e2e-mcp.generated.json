{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "name": "usefulapply",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "usefulapply"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "usefulapply-next-cache"
    },
    {
      "binding": "FILES",
      "bucket_name": "usefulapply-files"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usefulapply-db",
      "database_id": "8cd7059e-4f0b-429b-aace-e379756707e1",
      "migrations_dir": "migrations/d1"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "vars": {
    "JOB_FEED_RANKING_MODEL": "@cf/openai/gpt-oss-120b",
    "JOB_FEED_RANKING_FALLBACK_MODEL": "@cf/deepseek-ai/deepseek-v4-flash-0731",
    "MCP_ENABLED": "false"
  },
  "kv_namespaces": [
    {
      "binding": "CONTEXT_CACHE",
      "id": "2de5d12fd4934bbcad48fb1b95fc4cf6"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AGENT_GENERATION_QUEUE",
        "queue": "agent-generation"
      }
    ],
    "consumers": [
      {
        "queue": "agent-generation",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "agent-generation-dlq"
      },
      {
        "queue": "agent-generation-dlq",
        "max_batch_size": 1
      }
    ]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_AGENT_V2",
      "namespace_id": "3101",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },

{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/worker.ts",
	"name": "usefulapply",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference so ISR revalidation can call this worker.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "usefulapply"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Bucket created in Task 3.5. Local preview uses wrangler's simulated R2.
			"bucket_name": "usefulapply-next-cache"
		},
		{
			"binding": "FILES",
			// Wasim: `npx wrangler r2 bucket create usefulapply-files` (do not create from this task).
			// Local preview uses wrangler's simulated R2.
			"bucket_name": "usefulapply-files"
		}
	],
	// Cloudflare Email Service. usefulapply.com is onboarded for sending
	// (`npx wrangler email sending list`). Add `"remote": true` only for a
	// local send test, never commit it.
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	// Auth secrets (Wasim via `wrangler secret put`, never in this file):
	// BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "usefulapply-db",
			"database_id": "8cd7059e-4f0b-429b-aace-e379756707e1",
			"migrations_dir": "migrations/d1"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	// Browser Run renders the CV and cover letter PDFs (src/lib/services/export).
	// quickAction does not run in plain local dev: add "remote": true locally, never commit it.
	"browser": {
		"binding": "BROWSER"
	},
	// The deployed version id: keys the MCP discovery cache to the deploy (src/lib/mcp/well-known.ts).
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"vars": {
		// MCP server (/mcp), its OAuth server and /integrations. "false" turns all of them off (404).
		"MCP_ENABLED": "true"
	},
	"kv_namespaces": [
		{
			"binding": "CONTEXT_CACHE",
			"id": "2de5d12fd4934bbcad48fb1b95fc4cf6"
		}
	],
	// Queued kit generation (src/lib/services/generation-runner.ts). Messages carry
	// only an agent_operations id. One message per invocation, 3 retries, then the
	// dead-letter queue, which this Worker also consumes to fail the operation and
	// release its credits. Wasim: `npx wrangler queues create agent-generation` and
	// `npx wrangler queues create agent-generation-dlq` before the first deploy.
	"queues": {
		"producers": [
			{
				"binding": "AGENT_GENERATION_QUEUE",
				"queue": "agent-generation"
			}
		],
		"consumers": [
			{
				"queue": "agent-generation",
				"max_batch_size": 1,
				"max_retries": 3,
				"dead_letter_queue": "agent-generation-dlq"
			},
			{
				"queue": "agent-generation-dlq",
				"max_batch_size": 1
			}
		]
	},
	// One Rate Limiting binding per RATE_LIMITS bucket (60s windows).
	// namespace_id is an account-unique integer we pick; confirm unused in Task 3.5.
	// anon-parse hourly cap (5 / 3600s) stays in-memory; RATE_LIMIT_ANON_PARSE adds a 2 / 60s cap the binding can enforce.
	"ratelimits": [
		{
			"name": "RATE_LIMIT_AGENT_V2",
			"namespace_id": "3101",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_PARSE_CV",
			"namespace_id": "3102",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CHAT",
			"namespace_id": "3103",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CONTACT",
			"namespace_id": "3104",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_REGENERATE",
			"namespace_id": "3106",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_SIGNUP",
			"namespace_id": "3107",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_SIGNIN",
			"namespace_id": "3128",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_FORGOT_PASSWORD",
			"namespace_id": "3108",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_POST_CONFIRM",
			"namespace_id": "3109",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			// First tier in front of every job-feed route. High on purpose: it
			// caps a flood before the session lookup, and the per-route limit
			// after auth is the one keyed on the user.
			"name": "RATE_LIMIT_JOB_FEED_IP",
			"namespace_id": "3131",
			"simple": {
				"limit": 600,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_SETTINGS",
			"namespace_id": "3110",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_OVERVIEW",
			"namespace_id": "3111",
			"simple": {
				"limit": 15,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_SAVED",
			"namespace_id": "3112",
			"simple": {
				"limit": 15,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_FEEDBACK",
			"namespace_id": "3113",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_APPLY",
			"namespace_id": "3114",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_RUN",
			"namespace_id": "3115",
			"simple": {
				"limit": 2,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_INBOX",
			"namespace_id": "3117",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CREDITS_BALANCE",
			"namespace_id": "3118",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_DELETE_ACCOUNT",
			"namespace_id": "3119",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CREATE_CHECKOUT",
			"namespace_id": "3120",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CREATE_ADDON_CHECKOUT",
			"namespace_id": "3121",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CREATE_PORTAL",
			"namespace_id": "3122",
			"simple": {
				"limit": 3,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_APPLY_GEN",
			"namespace_id": "3123",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_JOB_FEED_APPLY_STATUS",
			"namespace_id": "3124",
			"simple": {
				"limit": 30,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_CAREER_PROFILE_GENERATE",
			"namespace_id": "3125",
			"simple": {
				"limit": 6,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_ANON_PARSE",
			"namespace_id": "3126",
			"simple": {
				"limit": 2,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_FILES_UPLOAD",
			"namespace_id": "3129",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_FILES_GET",
			"namespace_id": "3130",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_MCP",
			"namespace_id": "3132",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_MCP_OAUTH",
			"namespace_id": "3133",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_MCP_REGISTER",
			"namespace_id": "3134",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_EXPORTS",
			"namespace_id": "3140",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_EXPORTS_GET",
			"namespace_id": "3141",
			"simple": {
				"limit": 60,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_EXPORT_RENDER",
			"namespace_id": "3142",
			"simple": {
				"limit": 6,
				"period": 60
			}
		},
		// MCP tools that cost us something though they cost the user no credits (PR 5).
		{
			"name": "RATE_LIMIT_MCP_SAVE_CV",
			"namespace_id": "3150",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_MCP_SCREENING",
			"namespace_id": "3151",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RATE_LIMIT_MCP_EXPORT",
			"namespace_id": "3152",
			"simple": {
				"limit": 12,
				"period": 60
			}
		}
	],
	// Paid plan default is 30s CPU. Fit analysis + generation is LLM-bound
	// (unlimited wall clock, but CPU can exceed 30s). Max is 5 minutes.
	"limits": {
		"cpu_ms": 300000
	},
	// Live: "0 3 * * *" (credit reset sweep, cleanup), "0 8 * * *" (tracker
	// reminders) and "*/10 * * * *" (reconcile). The hourly confirmation resend
	// and the weekday check-in stay off until Phase 9.
	// Expressions must match src/cron/index.ts:
	// "0 3 * * *", "0 8 * * *", "*/10 * * * *", "0 * * * *", "0 9 * * 1-5".
	// Weekday check-in stays off: staging D1 holds imported production users
	// whose welcome_sent_at is already > 3 days old.
	// Workers Logs: without this the cron console.error lines are not persisted anywhere.
	"observability": {
		"enabled": true
	},
	"triggers": {
		"crons": [
			"0 3 * * *",
			"0 8 * * *",
			"*/10 * * * *",
			// "0 * * * *",
			// "0 9 * * 1-5"
		]
	},
	// Custom Domains create the DNS records and certificates automatically.
	"routes": [
		{
			"pattern": "usefulapply.com",
			"custom_domain": true
		},
		{
			"pattern": "www.usefulapply.com",
			"custom_domain": true
		},
		{
			// Admin dashboard host. Cloudflare Access (Zero Trust) fronts this
			// hostname; the Worker still verifies the Access JWT in-app.
			"pattern": "admin.usefulapply.com",
			"custom_domain": true
		}
	]
}

+export const APPLICATION_SUBJECT_PREFIXES: Record<string, string> = {
+  en: 'Application',
+  de: 'Bewerbung als',
+  fr: 'Candidature',
+  es: 'Candidatura',
+  pt: 'Candidatura',
+  it: 'Candidatura',
+  nl: 'Sollicitatie',
+};
+
+export const FOLLOW_UP_SUBJECT_PREFIXES: Record<string, string> = {
+  en: 'Following Up',
+  de: 'Nachfrage',
+  fr: 'Suivi de candidature',
+  es: 'Seguimiento',
+  pt: 'Acompanhamento',
+  it: 'Seguito candidatura',
+  nl: 'Opvolging sollicitatie',
+};
+
+const MAX_EMAIL_SUBJECT_CHARS = 60;
+const PRIMARY_TITLE_DELIMITER_RE = /[/|(]| [-\u2013\u2014] /u;
+const TRAILING_PUNCTUATION_OR_SPACE_RE = /[,.;:!?\-\u2013\u2014/&+|(\[\s]+$/u;
+
+function collapseSubjectWhitespace(value: string | null | undefined): string {
+  return (value ?? '').trim().replace(/\s+/gu, ' ');
+}
+
+function cleanSubjectText(value: string): string {
+  if (!value) return '';
+  return sanitizeDashes(fixTypos(value)).replace(/\s+/gu, ' ').trim();
+}
+
+function truncateAtWordBoundary(value: string, maxChars: number): string {
+  if (maxChars <= 0) return '';
+  if (value.length <= maxChars) {
+    return value.replace(TRAILING_PUNCTUATION_OR_SPACE_RE, '');
+  }
+  const slice = value.slice(0, maxChars + 1);
+  const lastSpace = slice.lastIndexOf(' ');
+  const lastHyphen = slice.slice(0, maxChars).lastIndexOf('-');
+  const cutIndex = lastSpace > 0 ? lastSpace : lastHyphen > 0 ? lastHyphen : maxChars;
+  return value.slice(0, cutIndex).replace(TRAILING_PUNCTUATION_OR_SPACE_RE, '');
+}
+
+function buildEmailSubject(
+  kind: 'application' | 'follow_up',
+  language: string,
+  jobTitle?: string | null,
+  applicantName?: string | null,
+): string {
+  const isGermanApplication = kind === 'application' && language === 'de';
+  const prefix = kind === 'application'
+    ? (APPLICATION_SUBJECT_PREFIXES[language] || APPLICATION_SUBJECT_PREFIXES.en)
+    : (FOLLOW_UP_SUBJECT_PREFIXES[language] || FOLLOW_UP_SUBJECT_PREFIXES.en);
+  const barePrefix = isGermanApplication ? 'Bewerbung' : prefix;
+
+  const rawTitle = collapseSubjectWhitespace(jobTitle);
+  const rawName = collapseSubjectWhitespace(applicantName);
+
+  if (!rawTitle && !rawName) {
+    return barePrefix;
+  }
+
+  const cleanName = cleanSubjectText(rawName);
+
+  if (!rawTitle) {
+    const head = `${barePrefix}: `;
+    const rawNoTitle = `${head}${rawName}`;
+    const cleanNoTitle = `${head}${cleanName}`;
+    if (rawNoTitle.length <= MAX_EMAIL_SUBJECT_CHARS && cleanNoTitle.length <= MAX_EMAIL_SUBJECT_CHARS) {
+      return cleanNoTitle;
+    }
+    const cutName = truncateAtWordBoundary(cleanName, MAX_EMAIL_SUBJECT_CHARS - head.length);
+    return cutName ? `${head}${cutName}` : barePrefix;
+  }
+
+  const head = isGermanApplication ? `${prefix} ` : `${prefix}: `;
+  const formatWithTitle = (title: string, name: string): string => (
+    name ? `${head}${title}, ${name}` : `${head}${title}`
+  );
+
+  const cleanTitle = cleanSubjectText(rawTitle);
+  const rawFull = formatWithTitle(rawTitle, rawName);
+  const cleanFull = formatWithTitle(cleanTitle, cleanName);
+  if (rawFull.length <= MAX_EMAIL_SUBJECT_CHARS && cleanFull.length <= MAX_EMAIL_SUBJECT_CHARS) {
+    return cleanFull;
+  }
+
+  const rawPrimarySplit = rawTitle.split(PRIMARY_TITLE_DELIMITER_RE)[0].trim();
+  const rawPrimaryTitle = rawPrimarySplit || rawTitle;
+  const cleanPrimaryTitle = cleanSubjectText(rawPrimaryTitle);
+
+  if (rawName) {
+    const rawPrimaryWithName = formatWithTitle(rawPrimaryTitle, rawName);
+    const cleanPrimaryWithName = formatWithTitle(cleanPrimaryTitle, cleanName);
+    if (
+      rawPrimaryWithName.length <= MAX_EMAIL_SUBJECT_CHARS
+      && cleanPrimaryWithName.length <= MAX_EMAIL_SUBJECT_CHARS
+    ) {
+      return cleanPrimaryWithName;
+    }
+  }
+
+  const rawPrimaryOnly = formatWithTitle(rawPrimaryTitle, '');
+  const cleanPrimaryOnly = formatWithTitle(cleanPrimaryTitle, '');
+  if (
+    rawPrimaryOnly.length <= MAX_EMAIL_SUBJECT_CHARS
+    && cleanPrimaryOnly.length <= MAX_EMAIL_SUBJECT_CHARS
+  ) {
+    return cleanPrimaryOnly;
+  }
+
+  const cutTitle = truncateAtWordBoundary(cleanPrimaryTitle, MAX_EMAIL_SUBJECT_CHARS - head.length);
+  return cutTitle ? `${head}${cutTitle}` : barePrefix;
+}
+
+export function buildApplicationEmailSubject(
+  language: string,
+  jobTitle?: string | null,
+  applicantName?: string | null,
+): string {
+  return buildEmailSubject('application', language, jobTitle, applicantName);
+}
+
+export function buildFollowUpEmailSubject(
+  language: string,
+  jobTitle?: string | null,
+  applicantName?: string | null,
+): string {
+  return buildEmailSubject('follow_up', language, jobTitle, applicantName);
+}

--- /dev/null
+++ b/src/lib/agents/prompts/email-subjects.ts
@@ -0,0 +1,91 @@
+/**
+ * Email subjects, built in code. The model writes email bodies only.
+ *
+ * Kept apart from email-prompts.ts so the eval prompt variants, which replace
+ * that module wholesale, never shadow it.
+ */
+
+import { fixTypos, sanitizeDashes } from '@/lib/config/typo-corrections';
+
+// Dash characters, built from code points so this source file contains none of them.
+const EM_DASH = String.fromCharCode(0x2014);
+const EN_DASH = String.fromCharCode(0x2013);
+
+const APPLICATION_SUBJECT_PREFIXES: Record<string, string> = {
+  en: 'Application',
+  de: 'Bewerbung',
+  fr: 'Candidature',
+  es: 'Candidatura',
+  pt: 'Candidatura',
+  it: 'Candidatura',
+  nl: 'Sollicitatie',
+};
+
+const FOLLOW_UP_SUBJECT_PREFIXES: Record<string, string> = {
+  en: 'Following Up',
+  de: 'Nachfrage',
+  fr: 'Suivi de candidature',
+  es: 'Seguimiento',
+  pt: 'Acompanhamento',
+  it: 'Seguito candidatura',
+  nl: 'Opvolging sollicitatie',
+};
+
+const MAX_SUBJECT_LENGTH = 60;
+const PRIMARY_TITLE_SEPARATOR = new RegExp(`[/|(]| [-${EN_DASH}${EM_DASH}] `);
+const TRAILING_SUBJECT_PUNCTUATION = new RegExp(`[\\s,.;:/|&(\\-${EN_DASH}${EM_DASH}]+$`);
+
+const collapseSpaces = (value: string | undefined): string => (value ?? '').replace(/\s+/g, ' ').trim();
+const cleanSubject = (value: string): string => sanitizeDashes(fixTypos(value)).trim();
+
+/**
+ * Build an email subject in code. The full "<head>, <name>" subject is used when
+ * it fits 60 characters after cleanup; otherwise the title shrinks to its primary
+ * part, then the name goes, then the title is cut at a word boundary.
+ */
+function buildEmailSubject(
+  compose: (title: string, name: string) => string,
+  rawTitle: string | undefined,
+  rawName: string | undefined,
+): string {
+  const title = collapseSpaces(rawTitle);
+  const name = collapseSpaces(rawName);
+  const primary = title.split(PRIMARY_TITLE_SEPARATOR)[0].trim() || title;
+  const fits = (subject: string) => cleanSubject(subject).length <= MAX_SUBJECT_LENGTH;
+
+  for (const [t, n] of [[title, name], [primary, name], [primary, '']]) {
+    const subject = compose(t, n);
+    if (fits(subject)) return cleanSubject(subject);
+  }
+  const words = primary.split(' ');
+  for (let count = words.length - 1; count > 0; count--) {
+    const subject = compose(words.slice(0, count).join(' ').replace(TRAILING_SUBJECT_PUNCTUATION, ''), '');
+    if (fits(subject)) return cleanSubject(subject);
+  }
+  return cleanSubject(compose('', ''));
+}
+
+export function buildApplicationEmailSubject(
+  language: string,
+  title: string | undefined,
+  name: string | undefined,
+): string {
+  const prefix = APPLICATION_SUBJECT_PREFIXES[language] || APPLICATION_SUBJECT_PREFIXES.en;
+  const isGerman = language === 'de';
+  return buildEmailSubject((t, n) => {
+    if (t) return `${prefix}${isGerman ? ' als ' : ': '}${t}${n ? `, ${n}` : ''}`;
+    return n ? `${prefix}: ${n}` : prefix;
+  }, title, name);
+}
+
+export function buildFollowUpEmailSubject(
+  language: string,
+  title: string | undefined,
+  name: string | undefined,
+): string {
+  const prefix = FOLLOW_UP_SUBJECT_PREFIXES[language] || FOLLOW_UP_SUBJECT_PREFIXES.en;
+  return buildEmailSubject((t, n) => {
+    const rest = [t, n].filter(Boolean).join(', ');
+    return rest ? `${prefix}: ${rest}` : prefix;
+  }, title, name);
+}

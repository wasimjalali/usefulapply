import { NextRequest, NextResponse } from 'next/server';
import { canViewJobFeed } from '@/lib/job-feed/helpers';
import {
  authorizeJobFeedJobActionAdmin,
  createOrReuseJobFeedApplicationGenerationAdmin,
  createJobFeedApplicationSessionAdmin,
  getJobFeedApplicationSessionAdmin,
  getJobFeedFeedbackAdmin,
  canReuseBlockedFeedbackSession,
  isJobFeedbackBlocked,
  recordJobFeedFeedbackAdmin,
  toJobFeedFeedbackState,
  transitionJobFeedApplicationGenerationAdmin,
} from '@/lib/job-feed/server';
import { captureJobFeedActionRejected, captureJobFeedEvent } from '@/lib/job-feed/analytics';
import { checkJobFeedIpGate, checkRateLimit, RATE_LIMITS } from '@/lib/middleware/rateLimiter';
import { getPostHogServer } from '@/lib/posthog-server';
import { getCurrentUser } from '@/auth/server';
import { getProfile } from '@/db/repos/profiles';
import { checkCreditBalance } from '@/db/repos/credits';

export const runtime = 'nodejs';

export async function POST(request: NextRequest) {
  let userId: string | null = null;
  let jobId = '';
  let runId = '';
  let subscriptionTier: string | null = null;

  try {
    const ipAllowed = await checkJobFeedIpGate(request);
    if (!ipAllowed) {
      captureJobFeedActionRejected({
        route: 'apply',
        action: 'apply_started',
        reason: 'rate_limited_ip',
        status: 429,
      });
      return NextResponse.json({ error: 'Too many requests. Please try again later.' }, { status: 429 });
    }

    const user = await getCurrentUser(request);

    if (!user) {
      captureJobFeedActionRejected({
        route: 'apply',
        action: 'apply_started',
        reason: 'unauthenticated',
        status: 401,
      });
      return NextResponse.json({ error: 'Authentication required.' }, { status: 401 });
    }
    userId = user.id;

    const { allowed } = await checkRateLimit(`job-feed-apply:${user.id}`, RATE_LIMITS['job-feed-apply']);
    if (!allowed) {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: 'rate_limited',
        status: 429,
      });
      return NextResponse.json({ error: 'Too many requests. Please try again later.' }, { status: 429 });
    }

    const profile = await getProfile(user.id);
    subscriptionTier = profile?.subscription_tier ?? null;

    // Intentionally canViewJobFeed (free + premium), NOT canAccessJobFeed. This
    // is a handoff that only creates a session + generation intent; it charges no
    // credits and exposes nothing premium-exclusive. The paywall is enforced
    // downstream in the agent flow. canViewJobFeed still denies unknown tiers.
    if (!profile || !canViewJobFeed(profile.subscription_tier)) {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: !profile ? 'profile_load_failed' : 'plan_not_allowed',
        status: 403,
        subscriptionTier,
      });
      return NextResponse.json({ error: 'Job Feed is not available for this account.' }, { status: 403 });
    }

    const body = await request.json().catch(() => ({} as Record<string, unknown>));
    jobId = typeof body?.jobId === 'string' ? body.jobId.trim() : '';
    runId = typeof body?.runId === 'string' ? body.runId.trim() : '';
    // Absent means the fit check, which is what an older tab sends and the
    // cheaper of the two. A value we do not know is a client bug, not a
    // default.
    const rawMode = body?.mode;
    if (rawMode !== undefined && rawMode !== 'analyze' && rawMode !== 'apply') {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: 'invalid_mode',
        status: 400,
        subscriptionTier,
      });
      return NextResponse.json({ error: 'Invalid request.' }, { status: 400 });
    }
    const creditAction = rawMode === 'apply' ? 'FULL_APPLICATION' : 'FIT_ANALYSIS';

    if (!jobId || jobId.length > 100 || runId.length > 100) {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: !jobId ? 'missing_job_id' : 'invalid_input_length',
        status: 400,
        subscriptionTier,
      });
      return NextResponse.json({ error: 'A job ID is required.' }, { status: 400 });
    }

    const authorizedItem = await authorizeJobFeedJobActionAdmin({
      userId: user.id,
      jobId,
      runId: runId || null,
    });
    if (!authorizedItem) {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: 'ranked_feed_item_not_found',
        jobId,
        runId: runId || null,
        status: 404,
        subscriptionTier,
      });
      return NextResponse.json({ error: 'Job Feed item not found.' }, { status: 404 });
    }
    const { job, rankedItem } = authorizedItem;
    const validatedRunId = rankedItem.run_id;

    const existingFeedback = await getJobFeedFeedbackAdmin(user.id, jobId);
    // Check the terminal state before the first write. recordJobFeedFeedbackAdmin
    // throws for a blocked row further down, and by then an empty session and a
    // generation intent are already in the sidebar. A stale client (dismiss,
    // then Check fit from the still-open detail) hits exactly this.
    if (
      existingFeedback
      && isJobFeedbackBlocked(existingFeedback)
      && !canReuseBlockedFeedbackSession(existingFeedback)
    ) {
      captureJobFeedActionRejected({
        userId,
        route: 'apply',
        action: 'apply_started',
        reason: 'feedback_terminal_state',
        jobId,
        runId: validatedRunId,
        status: 409,
        subscriptionTier,
      });
      return NextResponse.json({ error: 'This role has already moved on.' }, { status: 409 });
    }

    // A finished kit reopens through this route and charges nothing, so only
    // a request that will start a generation is priced. Everything else fails
    // closed: no balance, no rows.
    if (existingFeedback?.generation_status !== 'succeeded') {
      const balance = await checkCreditBalance(user.id, creditAction);
      if (!balance.hasEnough) {
        captureJobFeedActionRejected({
          userId,
          route: 'apply',
          action: 'apply_started',
          reason: 'insufficient_credits',
          jobId,
          runId: validatedRunId,
          status: 402,
          subscriptionTier,
        });
        return NextResponse.json({
          error: 'Not enough credits.',
          code: 'INSUFFICIENT_CREDITS',
          required: balance.required,
          available: balance.available,
        }, { status: 402 });
      }
    }

    let session = existingFeedback?.application_session_id
      ? await getJobFeedApplicationSessionAdmin({
          userId: user.id,
          sessionId: existingFeedback.application_session_id,
        })
      : null;
    let created = false;

    if (!session) {
      session = await createJobFeedApplicationSessionAdmin({
        userId: user.id,
        job,
      });
      created = true;
/**
 * Chat tool registry types. One typed list of tools (name, JSON schema,
 * handler); the chat route passes the definitions to callWorkersAI and
 * executes handlers server-side when the model returns tool calls.
 *
 * Ownership: every handler re-derives the user from ChatToolContext.userId
 * (set from the authenticated session) and queries through src/db/repos/*,
 * which check ownership per query. Tool arguments never carry a user id.
 */

import type { TailoredCV } from '@/lib/cv-structure/types';

export type NavigateTarget = 'tracker' | 'documents' | 'billing' | 'job-feed';

/** What the client is told happened, so stores refresh without a reload. */
export type ExecutedEffect =
  | { type: 'navigate'; target: NavigateTarget }
  | { type: 'tracker_updated'; sessionId: string; status: string }
  | { type: 'set_cv_template'; templateId: string }
  /**
   * The whole new CV object, computed server-side and shipped ready to apply.
   *
   * The server ships the result rather than an operation for the client to
   * replay, so there is exactly one resolution point: the object the reply
   * describes is byte-identically the object that gets written, and several
   * operations in one turn compose on the server's working copy instead of
   * racing on the client's. `baseDigest` is the digest of the CV the server
   * started from, so the client can refuse if a canvas edit landed meanwhile.
   */
  | { type: 'cv_structure_updated'; sessionId: string; cv: TailoredCV; baseDigest: string }
  | { type: 'propose_application' }
  | { type: 'feed_settings_updated' }
  | { type: 'run_feed' }
  | { type: 'feed_item_updated'; jobId: string; action: 'saved' | 'dismissed' }
  | { type: 'refresh_credits' };

/** A quick-action chip rendered under the reply (same shape the chat already uses). */
export interface ChatActionChip {
  label: string;
  action: string;
  icon: string;
}

export interface ChatToolContext {
  /** From the authenticated session, never from the request body. */
  userId: string;
  /** The user's own message this turn. Row-touching writes are gated on it naming the target. */
  userMessage: string;
  /**
   * The message looks pasted (a job ad, not a typed instruction), so naming a
   * company in it is not the user vouching for that target. Row-touching
   * writes refuse when this is set.
   */
  userMessagePasted: boolean;
  /** Validated IANA zone; 'UTC' when the client sent none. */
  timeZone: string;
  /** The saved application the client is looking at, if any (UUID-validated by the route). */
  sessionId: string | null;
  /**
   * The tailored CV the canvas is showing right now, sent by the client and
   * shape-checked by the route. Null when there is none.
   *
   * This is the first client-supplied CONTENT in this context, so: it is not a
   * trust escalation. `useSupabaseSync` already writes whatever the store holds
   * straight into D1, so a client sending a forged CV here is only editing its
   * own document, which it can already do directly through the canvas. The
   * handler deliberately does NOT read the CV from D1 instead: `getSession`
   * returns what the 2-second debounced sync last wrote, so a user who saves a
   * canvas edit and immediately asks the chat to reorder would have that edit
   * silently reverted by a D1-derived write. The store is the source of truth
   * and D1 is downstream of it.
   *
   * What the tools guarantee is narrower than trust, and it is the part that
   * matters: THE MODEL CANNOT WRITE CONTENT. The operations only permute,
   * delete and pick from a closed enum, and the conservation check in
   * cv-structure/validate.ts proves it on every edit.
   */
  tailoredCV: TailoredCV | null;
  /**
   * Read-before-edit, enforced mechanically rather than by prompt.
   * `get_cv_outline` sets this; every edit tool refuses while it is false.
   *
   * Mutable scratch on a request-scoped object. The route builds one
   * toolContext per request and passes the same object to every call, so this
   * cannot leak between users in a Worker isolate the way a module-level Map
   * would.
   */
  cvOutlineRead: boolean;
  /**
   * The working copy each successful edit mutates, so a second operation in the
   * same turn sees current handles and the operations compose into one final
   * object rather than two edits racing from the same base.
   */
  cvWorking: TailoredCV | null;
  /**
   * The template the canvas is rendering, validated against the catalog by the
   * route, null when the client sent none or an id we do not know.
   *
   * Needed because the templates truncate skills while rendering, so what an
   * edit does to the OBJECT and what it does to the PAGE are different
   * questions and only the template can answer the second. See
   * cv-structure/render-caps.ts.
   */
  cvTemplateId: string | null;
}

export interface ChatToolResult {
  /** Fed back to the model as the tool result. Small, factual, JSON-serializable. */
  data: unknown;
  /** The handler threw. The route must surface this rather than trust a generic model fallback. */
  failed?: true;
  executed?: ExecutedEffect[];
  /** Confirm chips for destructive proposals; the click is the second, confirming request. */
  actions?: ChatActionChip[];
}

export interface ChatTool {
  name: string;
  description: string;
  /** JSON schema for the arguments object. */
  parameters: Record<string, unknown>;
  handler: (args: Record<string, unknown>, ctx: ChatToolContext) => Promise<ChatToolResult>;
}
/**
 * App-awareness tools: what the open application contains, and which CV
 * template is in use.
 *
 * get_application_overview reads through getSession with the session-derived
 * userId, so it can only ever see this user's row. Company and role come from
 * a pasted job ad, so they are wrapped as data like everywhere else.
 *
 * set_cv_template changes client state only (the CV canvas re-renders and the
 * choice is saved as the user's default). It is reversible in one click, so it
 * executes immediately and the reply states the change.
 */

import { getSession } from '@/db/repos/sessions';
import { CV_TEMPLATE_IDS, cvTemplateCatalogForPrompt, cvTemplateName } from '@/lib/cv-templates/catalog';
import { flattenUntrusted } from './untrusted';
import type { ChatTool, ChatToolResult } from './types';

const getApplicationOverview: ChatTool = {
  name: 'get_application_overview',
  description:
    'Everything about the application open in this conversation: company, role, status, match score, which documents have been generated (CV, cover letter, application email, follow-up email), the CV template it uses and how many screening answers are left. Use for "what have I got for this one", "did I write the cover letter yet", "which template is this using".',
  parameters: { type: 'object', properties: {}, additionalProperties: false },
  handler: async (_args, ctx): Promise<ChatToolResult> => {
    if (!ctx.sessionId) {
      return { data: { error: 'No saved application is open in this conversation.' } };
    }
    const session = await getSession(ctx.userId, ctx.sessionId);
    if (!session) {
      return { data: { error: 'That application was not found.' } };
    }
    return {
      data: {
        company: `<<${flattenUntrusted(session.company)}>>`,
        role: `<<${flattenUntrusted(session.job_title)}>>`,
        status: session.status ?? 'drafted',
        match_score: session.match_score ?? null,
        has_cv: Boolean(session.generated_cv),
        has_cover_letter: Boolean(session.cover_letter),
        has_application_email: Boolean(session.email || session.email_body),
        has_follow_up_email: Boolean(session.follow_up_email),
        has_fit_assessment: Boolean(session.fit_assessment),
        // Null when this application has never had one picked. The template
        // named in the system prompt is the one on screen; do not guess here.
        cv_template: cvTemplateName(session.selected_template),
        selected_template: session.selected_template ?? null,
        screening_answers_used: session.screening_turns_used ?? 0,
        created_at: session.created_at,
      },
    };
  },
};

const setCvTemplate: ChatTool = {
  name: 'set_cv_template',
  description: `Switch the CV canvas to a different template and save it as the user's default for future applications. Call it only when the user asks to change or use a template. A question about templates ("which one suits Germany", "what would it look like in X") is a question: answer it and do not call this. Reversible, so when they do ask, apply it straight away.

Always call a template by the quoted name below, which is what the app shows the user. Never name a template after its template_id and never invent a layout for one.

${cvTemplateCatalogForPrompt()}`,
  parameters: {
    type: 'object',
    properties: {
      template_id: { type: 'string', enum: CV_TEMPLATE_IDS },
    },
    required: ['template_id'],
    additionalProperties: false,
  },
  handler: async (args): Promise<ChatToolResult> => {
    const templateId = CV_TEMPLATE_IDS.find((candidate) => candidate === args.template_id);
    if (!templateId) {
      return { data: { error: 'Unknown template. Offer the user one from the list in this tool.' } };
    }
    return {
      data: { ok: true, template: cvTemplateName(templateId) ?? templateId },
      executed: [{ type: 'set_cv_template', templateId }],
    };
  },
};

export const APP_TOOLS: ChatTool[] = [getApplicationOverview, setCvTemplate];
export const CREDIT_COSTS = {
  FULL_APPLICATION: 2.0,
  GENERATION_AFTER_FIT: 1.5,
  FIT_ANALYSIS: 0.5,
  CV_OPTIMIZATION: 1,
  COVER_LETTER_REGEN: 0.5,
  EMAIL_REGEN: 0.5,
  FOLLOW_UP_REGEN: 0.5,
  /** One section of an already-tailored CV. Priced with the other single-document rewrites, approved 2026-08-21. */
  CV_SECTION_REWRITE: 0.5,
} as const;

export type CreditAction = keyof typeof CREDIT_COSTS;

/**
 * Credits given back for each kit document that failed while the rest of the
 * kit was delivered (founder request, 2026-10-12). It is that document's
 * single-document regenerate price, so retrying it from its tab is net free.
 * The CV has no single-document regenerate, so it is refunded at the same 0.5.
 * The total is capped at what the kit reservation charged. A kit where every
 * document failed is released in full instead.
 */
export const KIT_DOCUMENT_FAILURE_REFUND = {
  cv: 0.5,
  coverLetter: CREDIT_COSTS.COVER_LETTER_REGEN,
  applicationEmail: CREDIT_COSTS.EMAIL_REGEN,
  followUpEmail: CREDIT_COSTS.FOLLOW_UP_REGEN,
} as const;

/**
 * The bucket a ledger row belongs to, written into
 * `credit_transactions.transaction_kind` at insert.
 *
 * `transaction_type` stays free text and keeps naming the exact action. This
 * set is closed, so the usage breakdown reads a value the writer chose rather
 * than guessing from a string it has never seen. Adding a credit action means
 * adding it to CREDIT_ACTION_KIND below, which the compiler insists on.
 */
export const CREDIT_TRANSACTION_KINDS = ['fit', 'kit', 'rewrite', 'grant', 'refund'] as const;
export type CreditTransactionKind = (typeof CREDIT_TRANSACTION_KINDS)[number];

export const CREDIT_ACTION_KIND: Record<CreditAction, CreditTransactionKind> = {
  FULL_APPLICATION: 'kit',
  GENERATION_AFTER_FIT: 'kit',
  FIT_ANALYSIS: 'fit',
  CV_OPTIMIZATION: 'rewrite',
  COVER_LETTER_REGEN: 'rewrite',
  EMAIL_REGEN: 'rewrite',
  FOLLOW_UP_REGEN: 'rewrite',
  CV_SECTION_REWRITE: 'rewrite',
};

/**
 * Rows written before the column existed carry a null kind, so they are read
 * back through the free-text type. Measured on the live ledger: 643 rows across
 * nine types, one of them `full_generation`, a retired name for a kit that the
 * old else-branch counted as a rewrite.
 */
const LEGACY_TYPE_KIND: Record<string, CreditTransactionKind> = {
  fit_analysis: 'fit',
  full_application: 'kit',
  generation_after_fit: 'kit',
  full_generation: 'kit',
  cv_optimization: 'rewrite',
  cover_letter_regen: 'rewrite',
  email_regen: 'rewrite',
  follow_up_regen: 'rewrite',
  monthly_reset: 'grant',
  plan_upgrade: 'grant',
  addon_purchase: 'grant',
  refund: 'refund',
};

function isCreditTransactionKind(value: unknown): value is CreditTransactionKind {
  return typeof value === 'string' && (CREDIT_TRANSACTION_KINDS as readonly string[]).includes(value);
}

/**
 * The kind of one ledger row. Prefers the stored kind, falls back to the type
 * for older rows, and returns null when neither is recognised so a caller can
 * leave an unknown row out of a count instead of inventing a bucket for it.
 */
export function creditTransactionKind(row: {
  transaction_kind?: string | null;
  transaction_type?: string | null;
}): CreditTransactionKind | null {
  if (isCreditTransactionKind(row.transaction_kind)) return row.transaction_kind;
  const legacy = row.transaction_type ? LEGACY_TYPE_KIND[row.transaction_type] : undefined;
  return legacy ?? null;
}

export function getTotalCredits(credits: {
  monthly_credits: number;
  rollover_credits: number;
  addon_credits: number;
}): number {
  return credits.monthly_credits + credits.rollover_credits + credits.addon_credits;
}

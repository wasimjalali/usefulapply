/**
 * CV PDF export. Captures a rendered CV template element with html2canvas and
 * slices it into pages with jsPDF. Shared by the CV tab's Download PDF and the
 * kit-wide Download all, which renders the template offscreen.
 */

import { getCaptureScale, getIsMobileOrTablet } from '@/lib/utils/download-pdf';

// White margin added at the top and bottom of every PDF page (~10mm).
// Content per page = pageHeight - 2×gutter; both the PDF slicer and the
// preview indicator must use the same value so the line matches the cut.
export const CV_PAGE_GUTTER_PX = 40;

/**
 * Implements CSS `object-fit: cover` logic on a canvas: center-crops the source
 * image to fill the target dimensions, then returns a small JPEG data URL.
 * This replaces the html2canvas background-image workaround that caused blurry
 * photos and layout shifts.
 */
function cropImageCover(
  src: string,
  targetW: number,
  targetH: number,
  quality = 0.92,
): Promise<string> {
  return new Promise((resolve, reject) => {
    const img = new Image();
    img.onload = () => {
      const srcRatio = img.naturalWidth / img.naturalHeight;
      const tgtRatio = targetW / targetH;

      let sx: number, sy: number, sw: number, sh: number;
      if (srcRatio > tgtRatio) {
        // Source is wider — crop horizontally
        sh = img.naturalHeight;
        sw = sh * tgtRatio;
        sx = (img.naturalWidth - sw) / 2;
        sy = 0;
      } else {
        // Source is taller — crop vertically
        sw = img.naturalWidth;
        sh = sw / tgtRatio;
        sx = 0;
        sy = (img.naturalHeight - sh) / 2;
      }

      const canvas = document.createElement('canvas');
      canvas.width = targetW;
      canvas.height = targetH;
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return reject(new Error('Could not get 2d context'));
      ctx.drawImage(img, sx, sy, sw, sh, 0, 0, targetW, targetH);
      resolve(canvas.toDataURL('image/jpeg', quality));
    };
    img.onerror = () => reject(new Error('Image load failed'));
    img.src = src;
  });
}

/**
 * Scans the captured canvas for the row with the fewest non-white pixels
 * near `targetY`, within ±`searchRange` pixels. Returns the optimal Y
 * coordinate for slicing to avoid cutting through text.
 */
function findBestBreakY(
  canvas: HTMLCanvasElement,
  targetY: number,
  searchRange: number,
): number {
  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  if (!ctx) return targetY;

  const startY = Math.max(0, targetY - searchRange);
  const endY = Math.min(canvas.height - 1, targetY);
  if (startY >= endY) return targetY;

  const width = canvas.width;
  let bestY = targetY;
  let bestScore = Infinity;

  for (let y = startY; y <= endY; y++) {
    const row = ctx.getImageData(0, y, width, 1).data;
    let darkPixels = 0;
    for (let x = 0; x < width; x++) {
      const idx = x * 4;
      // A pixel is "dark" (non-white) if any channel is below 240
      if (row[idx] < 240 || row[idx + 1] < 240 || row[idx + 2] < 240) {
        darkPixels++;
      }
    }
    if (darkPixels < bestScore) {
      bestScore = darkPixels;
      bestY = y;
    }
  }
  return bestY;
}

export interface CvPdfOptions {
  templateId: string;
  photoUrl?: string;
  onStep?: (step: string) => void;
}

/** Render `el` (a mounted CVTemplateRenderer wrapper) to a paged PDF blob. */
export async function generateCvPdfBlob(el: HTMLElement, opts: CvPdfOptions): Promise<Blob> {
  // Step tracking for mobile diagnostics: the step name is shown in the
  // error toast so the user can report exactly where the failure occurs.
  const step = opts.onStep ?? (() => {});
  step('import');
  const [{ default: html2canvas }, { jsPDF }] = await Promise.all([
    import('html2canvas'),
    import('jspdf'),
  ]);

  const isGerman = opts.templateId.startsWith('german');
  const pageWidthMm = isGerman ? 210 : 215.9;
  const pageHeightMm = isGerman ? 297 : 279.4;
  // Page height in natural pixels at 96 dpi
  const pageHeightNaturalPx = isGerman ? Math.round((297 / 25.4) * 96) : 1056;
  const isMobile = getIsMobileOrTablet();

  step('css-clean');
  // --- Determine capture scale ---
  // Start with device-appropriate scale, then cap to stay within iOS Safari's
  // maximum canvas area (~16M pixels). Exceeding this silently produces a blank
  // canvas with no error thrown.
  const MAX_CANVAS_AREA = 16_000_000;
  const naturalW = el.scrollWidth;
  const naturalH = el.scrollHeight;
  let captureScale = getCaptureScale();
  while (
    naturalW * captureScale * naturalH * captureScale > MAX_CANVAS_AREA &&
    captureScale > 1
  ) {
    captureScale -= 0.5;
  }
  // Debug: log dimensions for mobile diagnostics (visible in console)
  console.log(`[PDF] mobile=${isMobile} el=${naturalW}x${naturalH} scale=${captureScale} canvas=${naturalW * captureScale}x${naturalH * captureScale} area=${(naturalW * captureScale * naturalH * captureScale / 1e6).toFixed(1)}M`);

  // html2canvas 1.4.1 can't parse CSS Color Level 4 functions (oklch, lab, etc.)
  // used by Tailwind v4. Pre-fetch all stylesheets, replace unsupported color values,
  // then inject the cleaned CSS in onclone (which is synchronous — can't fetch inside it).
  const unsupportedColorRe = /\b(?:oklch|oklab|lab|lch)\s*\([^)]*\)/g;
  const cssMap = new Map<string, string>();

  // Try CSSOM first (synchronous, no network) — works for same-origin sheets.
  // Falls back to fetch for any sheets where CSSOM access throws SecurityError.
  const fetchFallbackLinks: HTMLLinkElement[] = [];
  const linkEls = Array.from(
    document.head.querySelectorAll<HTMLLinkElement>('link[rel="stylesheet"]')
  );

  for (const link of linkEls) {
    try {
      const sheet = Array.from(document.styleSheets).find(
        (s) => s.href === link.href
      );
      if (sheet && sheet.cssRules) {
        const rules = Array.from(sheet.cssRules)
          .map((r) => r.cssText)
          .join('\n');
        cssMap.set(link.href, rules.replace(unsupportedColorRe, 'inherit'));
      } else {
        fetchFallbackLinks.push(link);
      }
    } catch {
      // SecurityError for cross-origin sheets — fall back to fetch on desktop
      if (!isMobile) fetchFallbackLinks.push(link);
    }
  }

  // Fetch any sheets that CSSOM couldn't read (desktop only — mobile skips
  // network fetches to avoid timeout/CORS failures on slow connections)
  if (fetchFallbackLinks.length > 0 && !isMobile) {
    await Promise.allSettled(
      fetchFallbackLinks.map(async (link) => {
        try {
          const res = await fetch(link.href);
          const css = await res.text();
          cssMap.set(link.href, css.replace(unsupportedColorRe, 'inherit'));
        } catch { /* leave out of map — link will be replaced with empty style */ }
      })
    );
  }

  // Pre-fetch photo as base64 and pre-crop it to exactly match the container
  // dimensions × captureScale. Skip on mobile to save memory — the photo will
  // still render (just via html2canvas's native handling).
  let croppedPhotoDataUrl: string | null = null;
  const photoSrc = opts.photoUrl;
  if (photoSrc && !isMobile) {
    try {
      let photoBase64 = photoSrc;
      if (!photoSrc.startsWith('data:')) {
        const resp = await fetch(photoSrc);
        const blob = await resp.blob();
        photoBase64 = await new Promise<string>((resolve, reject) => {
          const reader = new FileReader();
          reader.onloadend = () => resolve(reader.result as string);
          reader.onerror = reject;
          reader.readAsDataURL(blob);
        });
      }
      let liveImg: HTMLImageElement | null = null;
      for (const img of Array.from(el.querySelectorAll<HTMLImageElement>('img'))) {
        if (img.style.objectFit === 'cover' || img.style.objectFit === 'contain') {
          liveImg = img;
          break;
        }
      }
      if (liveImg && liveImg.parentElement) {
        const containerW = liveImg.parentElement.offsetWidth;
        const containerH = liveImg.parentElement.offsetHeight;
        if (containerW > 0 && containerH > 0) {
          croppedPhotoDataUrl = await cropImageCover(
            photoBase64,
            containerW * captureScale,
            containerH * captureScale,
          );
        }
      }
      if (!croppedPhotoDataUrl) {
        croppedPhotoDataUrl = photoBase64;
      }
    } catch {
      console.warn('Could not pre-fetch/crop profile photo for PDF');
    }
  }

/**
 * Cover letter export: plain text, PDF (jsPDF) and DOCX (docx). Shared by the
 * cover letter tab and the kit-wide Download all.
 */

import { jsPDF } from 'jspdf';
import { Document, Packer, Paragraph, TextRun } from 'docx';
import type { GeneratedCoverLetter } from '@/lib/types';

export function formatCoverLetterAsText(letter: GeneratedCoverLetter): string {
  // If body contains the full letter (3-agent architecture), return it directly
  if (!letter.applicantAddress.name && letter.body) {
    return letter.body;
  }
  // Otherwise, format structured data
  return `${letter.applicantAddress.name}
${letter.applicantAddress.street}
${letter.applicantAddress.city}
${letter.applicantAddress.country}
${letter.applicantAddress.phone}
${letter.applicantAddress.email}

${letter.date}

${letter.companyAddress.companyName}
${letter.companyAddress.department || ''}
${letter.companyAddress.street || ''}
${letter.companyAddress.city || ''}

${letter.salutation}

${letter.body}

${letter.closing}

${letter.signatureName}`;
}

export function hasAddressPlaceholder(letter: GeneratedCoverLetter): boolean {
  const fullText = formatCoverLetterAsText(letter);
  return fullText.includes('[Company Address') || fullText.includes('[Insert Company Address');
}

export function countWords(text: string): number {
  return text.trim().split(/\s+/).filter(Boolean).length;
}

export function buildCoverLetterPdfBlob(letter: GeneratedCoverLetter): Blob {
  const doc = new jsPDF();
  
  const margin = 20;
  const pageWidth = doc.internal.pageSize.getWidth();
  const maxWidth = pageWidth - margin * 2;
  let yPos = margin;
  const lineHeight = 6;
  
  doc.setFontSize(11);
  doc.setFont('helvetica', 'normal');
  
  // Check if this is body-only format (3-agent architecture)
  if (!letter.applicantAddress.name && letter.body) {
    // Body contains the full letter - just render it
    const bodyLines = doc.splitTextToSize(letter.body, maxWidth);
    for (const line of bodyLines) {
      if (yPos > 270) {
        doc.addPage();
        yPos = margin;
      }
      doc.text(line, margin, yPos);
      yPos += lineHeight;
    }
  } else {
    // Structured format - render each section
    // Applicant Address
    doc.setFont('helvetica', 'bold');
    doc.text(letter.applicantAddress.name, margin, yPos);
    doc.setFont('helvetica', 'normal');
    yPos += lineHeight;
    if (letter.applicantAddress.street) {
      doc.text(letter.applicantAddress.street, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.applicantAddress.city) {
      doc.text(letter.applicantAddress.city, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.applicantAddress.country) {
      doc.text(letter.applicantAddress.country, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.applicantAddress.phone) {
      doc.text(letter.applicantAddress.phone, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.applicantAddress.email) {
      doc.text(letter.applicantAddress.email, margin, yPos);
      yPos += lineHeight;
    }
    yPos += lineHeight;
    
    // Date
    if (letter.date) {
      doc.text(letter.date, margin, yPos);
      yPos += lineHeight * 2;
    }
    
    // Company Address
    if (letter.companyAddress.companyName) {
      doc.setFont('helvetica', 'bold');
      doc.text(letter.companyAddress.companyName, margin, yPos);
      doc.setFont('helvetica', 'normal');
      yPos += lineHeight;
    }
    if (letter.companyAddress.department) {
      doc.text(letter.companyAddress.department, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.companyAddress.street) {
      doc.text(letter.companyAddress.street, margin, yPos);
      yPos += lineHeight;
    }
    if (letter.companyAddress.city) {
      doc.text(letter.companyAddress.city, margin, yPos);
      yPos += lineHeight;
    }
    yPos += lineHeight;
    
    // Salutation
    if (letter.salutation) {
      doc.text(letter.salutation, margin, yPos);
      yPos += lineHeight * 2;
    }
    
    // Body - split into lines
    const bodyLines = doc.splitTextToSize(letter.body, maxWidth);
    for (const line of bodyLines) {
      if (yPos > 270) {
        doc.addPage();
        yPos = margin;
      }
      doc.text(line, margin, yPos);
      yPos += lineHeight;
    }
    yPos += lineHeight;
    
    // Closing
    if (letter.closing) {
      doc.text(letter.closing, margin, yPos);
      yPos += lineHeight * 3;
    }
    
    // Signature
    if (letter.signatureName) {
      doc.setFont('helvetica', 'bold');
      doc.text(letter.signatureName, margin, yPos);
    }
  }
  return doc.output('blob');
}

export async function buildCoverLetterDocxBlob(letter: GeneratedCoverLetter): Promise<Blob> {
  // Check if this is body-only format (3-agent architecture)
  const isBodyOnly = !letter.applicantAddress.name && letter.body;
  
  let children: Paragraph[];
  
  if (isBodyOnly) {
    // Body contains the full letter - split by paragraphs
    children = letter.body.split('\n\n').map(para => 
      new Paragraph({ 
        children: [new TextRun(para.trim())],
        spacing: { after: 200 },
      })
    );
  } else {
    // Structured format - render each section
    children = [
      // Applicant Address
      new Paragraph({
        children: [new TextRun({ text: letter.applicantAddress.name, bold: true })],
      }),
      ...(letter.applicantAddress.street ? [new Paragraph({ children: [new TextRun(letter.applicantAddress.street)] })] : []),
      ...(letter.applicantAddress.city ? [new Paragraph({ children: [new TextRun(letter.applicantAddress.city)] })] : []),
      ...(letter.applicantAddress.country ? [new Paragraph({ children: [new TextRun(letter.applicantAddress.country)] })] : []),
      ...(letter.applicantAddress.phone ? [new Paragraph({ children: [new TextRun(letter.applicantAddress.phone)] })] : []),
      ...(letter.applicantAddress.email ? [new Paragraph({ children: [new TextRun(letter.applicantAddress.email)] })] : []),
      new Paragraph({ children: [] }), // Empty line
      
      // Date
      ...(letter.date ? [new Paragraph({ children: [new TextRun(letter.date)] })] : []),
      new Paragraph({ children: [] }), // Empty line
      
      // Company Address
      ...(letter.companyAddress.companyName ? [new Paragraph({
        children: [new TextRun({ text: letter.companyAddress.companyName, bold: true })],
      })] : []),
      ...(letter.companyAddress.department ? [new Paragraph({ children: [new TextRun(letter.companyAddress.department)] })] : []),
      ...(letter.companyAddress.street ? [new Paragraph({ children: [new TextRun(letter.companyAddress.street)] })] : []),
      ...(letter.companyAddress.city ? [new Paragraph({ children: [new TextRun(letter.companyAddress.city)] })] : []),
      new Paragraph({ children: [] }), // Empty line
'use client';

import { CVData, CVTemplate, CV_TEMPLATE_DEFINITIONS, getTemplateById } from '@/lib/cv-templates/types';
import { USPremiumATSTemplate } from './USPremiumATSTemplate';
import { USModernATSTemplate } from './USModernATSTemplate';
import { USProfessionalTemplate } from './USProfessionalTemplate';
import { GermanATSTemplate } from './GermanATSTemplate';
import { GermanClassicTemplate } from './GermanClassicTemplate';
import { ClassicGreenTemplate } from './ClassicGreenTemplate';

export { CV_TEMPLATE_DEFINITIONS, getTemplateById };
export type { CVData, CVTemplate };

// Export premium template for direct use
export { USPremiumATSTemplate, GermanATSTemplate, GermanClassicTemplate, ClassicGreenTemplate };

interface CVTemplateRendererProps {
  data: CVData;
  templateId: string;
}

/**
 * CV Template Renderer - 6 Premium Templates
 * 1. premium-ats - Default, best for most applications
 * 2. modern-professional - Tech/startups
 * 3. executive - Senior roles
 * 4. german-ats - German market (two-column with photo)
 * 5. german-classic - German market (single-column with photo)
 * 6. classic-green - English market, forest green accent
 */
export function CVTemplateRenderer({ data, templateId }: CVTemplateRendererProps) {
  const template = getTemplateById(templateId);
  
  if (!template) {
    // Fallback to premium-ats if template not found
    const defaultTemplate = getTemplateById('premium-ats');
    if (defaultTemplate) {
      return <USPremiumATSTemplate data={data} template={defaultTemplate} />;
    }
    return (
      <div className="p-8 text-center text-gray-500">
        Template not found: {templateId}
      </div>
    );
  }
  
  // Extract photo URL from data.personal if available
  const photoUrl = data.personal?.photoUrl;
  
  // Map template IDs to components (6 templates)
  switch (templateId) {
    case 'premium-ats':
      return <USPremiumATSTemplate data={data} template={template} photoUrl={photoUrl} />;
    
    case 'modern-professional':
      return <USModernATSTemplate data={data} template={template} />;
    
    case 'executive':
      return <USProfessionalTemplate data={data} template={template} />;
    
    case 'german-ats':
      return <GermanATSTemplate data={data} template={template} photoUrl={photoUrl} />;
    
    case 'german-classic':
      return <GermanClassicTemplate data={data} template={template} photoUrl={photoUrl} />;
    
    case 'classic-green':
      return <ClassicGreenTemplate data={data} template={template} />;
    
    // Legacy template ID fallbacks (for existing users)
    case 'us-premium-ats':
    case 'us-ats-maximizer':
    case 'us-modern-ats':
    case 'us-technical':
    case 'us-classic':
    case 'eu-premium-ats':
    case 'eu-modern-ats':
    case 'eu-classic':
    case 'eu-german-ats':
    case 'eu-german-professional':
      return <USPremiumATSTemplate data={data} template={template} />;
    
    case 'us-executive':
    case 'eu-sidebar':
    case 'us-professional':
    case 'eu-professional':
      return <USProfessionalTemplate data={data} template={template} />;
    
    default:
      return <USPremiumATSTemplate data={data} template={template} />;
  }
}

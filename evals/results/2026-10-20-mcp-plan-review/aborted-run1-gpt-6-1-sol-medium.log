function resolveOwnedCvKey(userId: string, storagePath: unknown): string | null {
  if (typeof storagePath !== 'string') return null;
  if (storagePath.includes('\\') || storagePath.includes('..')) return null;
  const segments = storagePath.split('/');
  if (segments.some((segment) => segment.length === 0)) return null;
  const fileOk = (name: string) => /^[A-Za-z0-9_-]+\.[A-Za-z0-9]+$/.test(name);
  const typeOk = (type: string) => type === 'primary_cv' || type === 'master_cv';
  if (
    segments.length === 4
    && segments[0] === 'cv-files'
    && segments[1] === userId
    && typeOk(segments[2])
    && fileOk(segments[3])
  ) {
    return storagePath;
  }
  if (
    segments.length === 3
    && segments[0] === userId
    && typeOk(segments[1])
    && fileOk(segments[2])
  ) {
    return `cv-files/${storagePath}`;
  }
  return null;
}

function hasMinimumCvSignals(cv: StructuredCV): boolean {
  const hasName = cv.personal.fullName.trim().length > 0;
  const hasExperience = cv.experience.some((entry) =>
    entry.company.trim().length > 0 || entry.position.trim().length > 0 || entry.bullets.length > 0,
  );
  const hasEducation = cv.education.some((entry) =>
    entry.institution.trim().length > 0 || entry.degree.trim().length > 0,
  );
  const hasSkills = cv.skills.some((category) => category.skills.length > 0);
  return hasName && (hasExperience || hasEducation || hasSkills);
}


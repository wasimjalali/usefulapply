{
  "queriedAt": "2026-10-22",
  "window": "last 30 days",
  "note": "SELECT only, aggregate counts and token sums only. Feed tier is the profile current tier, not the tier at run time.",
  "queries": {
    "llm_generations": "SELECT feature, operation, provider, model, status, count(*) n, sum(input_tokens) i, sum(output_tokens) o, sum(cache_read_input_tokens) cr FROM llm_generations WHERE started_at > datetime('now','-30 days') GROUP BY 1,2,3,4,5 ORDER BY n DESC",
    "chat_messages": "SELECT role, count(*) n FROM chat_messages WHERE created_at > datetime('now','-30 days') GROUP BY role",
    "feed_runs": "SELECT p.subscription_tier tier, r.status, r.trigger_source, count(*) n, count(distinct r.user_id) users FROM job_feed_runs r JOIN profiles p ON p.id = r.user_id WHERE r.created_at > datetime('now','-30 days') GROUP BY 1,2,3",
    "sessions": "SELECT count(*) sessions_created_30d, sum(screening_turns_used) screening_turns_on_those, sum(case when screening_turns_used>0 then 1 else 0 end) with_screening FROM application_sessions WHERE created_at > datetime('now','-30 days')",
    "users": "distinct user_id counts over llm_generations, chat_messages, application_sessions and job_feed_runs in the window, plus count(*) of profiles"
  },

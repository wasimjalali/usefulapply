{
  "name": "ats-export-eval",
  "private": true,
  "version": "1.0.0",
  "description": "ATS and layout eval for the CV and cover letter export. Its own package so the app's lockfile stays untouched.",
  "scripts": {
    "setup:ats": "bash ats/setup.sh",
    "fetch:openresume": "bash fetch-open-resume.sh",
    "worker": "wrangler dev --config render-worker/wrangler.jsonc --port 8793",
    "typecheck": "tsc -p tsconfig.json",
    "eval": "tsx --tsconfig tsconfig.json run.ts",
    "eval:write": "tsx --tsconfig tsconfig.json run.ts --write",
    "summarize": "tsx --tsconfig tsconfig.json summarize.ts",
    "baseline": "tsx --tsconfig tsconfig.json baseline.ts",
    "parity": "tsx --tsconfig tsconfig.json parity.ts",
    "e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@playwright/test": "1.55.0",
    "esbuild": "0.25.4",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.5.207",
    "sharp": "0.34.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "wrangler": "4.123.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19"
  }
}
